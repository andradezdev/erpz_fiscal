    "margin_right": 10.0,
    "margin_top": 10.0,
    "modified": "2026-09-16 12:00:00.000000",
    "modified_by": "Administrator",
    "module": "ERPZ Fiscal",
    "name": "Mapa de Carregamento Consolidado",
    "owner": "Administrator",
    "print_format_type": "Jinja",
    "standard": "Yes",
    "html": "<div class=\"print-format mapa-consolidado\">\n    <style>\n        .mapa-consolidado { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; font-size: 11px; color: #1f2937; line-height: 1.4; }\n        .header-box { border-bottom: 2px solid #1f2937; padding-bottom: 8px; margin-bottom: 12px; }\n        .company-title { font-size: 16px; font-weight: bold; text-transform: uppercase; }\n        .doc-title { font-size: 14px; font-weight: bold; color: #4b5563; }\n        .table-data { width: 100%; border-collapse: collapse; margin-top: 10px; }\n        .table-data th { background: #f3f4f6; border: 1px solid #d1d5db; padding: 6px 8px; font-size: 10px; text-transform: uppercase; text-align: left; }\n        .table-data td { border: 1px solid #e5e7eb; padding: 6px 8px; font-size: 10px; }\n    </style>\n\n    <div class=\"header-box\">\n        <div style=\"display: flex; justify-content: space-between; align-items: flex-end;\">\n            <div>\n                <div class=\"company-title\">{{ doc.empresa }}</div>\n                <div class=\"doc-title\">MAPA DE CARREGAMENTO CONSOLIDADO (CONFER?NCIA DE BA?)</div>\n            </div>\n            <div style=\"text-align: right;\">\n                <div style=\"font-size: 15px; font-weight: bold; color: #1e40af;\">CARGA Nº {{ doc.name }}</div>\n                <div><b>Data:</b> {{ frappe.utils.format_date(doc.data_carga) }}</div>\n            </div>\n        </div>\n    </div>\n\n    <table style=\"width: 100%; margin-bottom: 10px; font-size: 11px;\">\n        <tr>\n            <td style=\"width: 33%;\"><b>Veículo:</b> {{ doc.placa_veículo or 'N/A' }}</td>\n            <td style=\"width: 33%;\"><b>Motorista:</b> {{ doc.motorista_nome or 'N/A' }}</td>\n            <td style=\"width: 34%;\"><b>Total Pedidos:</b> {{ doc.total_pedidos }} | <b>Volumes:</b> {{ doc.total_volumes }}</td>\n        </tr>\n    </table>\n\n    <table class=\"table-data\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%;\">#</th>\n                <th style=\"width: 20%;\">Código do Item</th>\n                <th style=\"width: 45%;\">Descrição do Produto</th>\n                <th style=\"width: 10%; text-align: center;\">UN</th>\n                <th style=\"width: 10%; text-align: center;\">Qtd Total</th>\n                <th style=\"width: 10%; text-align: right;\">Peso Total (kg)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set produtos = {} %}\n            {% for row in doc.itens %}\n                {% set so = frappe.get_doc(\"Sales Order\", row.sales_order) %}\n                {% for item in so.items %}\n                    {% if item.item_code not in produtos %}\n                        {% set item_pb = frappe.db.get_value(\"Item\", item.item_code, \"peso_bruto\") or 0 %}\n                        {% set _ = produtos.update({item.item_code: {'name': item.item_name, 'uom': item.uom, 'qty': item.qty, 'peso': (item.qty * item_pb)}}) %}\n                    {% else %}\n                        {% set current = produtos[item.item_code] %}\n                        {% set item_pb = frappe.db.get_value(\"Item\", item.item_code, \"peso_bruto\") or 0 %}\n                        {% set _ = current.update({'qty': current.qty + item.qty, 'peso': current.peso + (item.qty * item_pb)}) %}\n                    {% endif %}\n                {% endfor %}\n            {% endfor %}\n\n            {% for item_code, p in produtos.items() %}\n            <tr>\n                <td style=\"text-align: center;\">{{ loop.index }}</td>\n                <td><b>{{ item_code }}</b></td>\n                <td>{{ p.name }}</td>\n                <td style=\"text-align: center;\">{{ p.uom }}</td>\n                <td style=\"text-align: center;\"><b>{{ p.qty }}</b></td>\n                <td style=\"text-align: right;\">{{ p.peso | round(3) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr style=\"background: #f9fafb; font-weight: bold;\">\n                <td colspan=\"4\" style=\"text-align: right;\">TOTAL GERAL DA CARGA:</td>\n                <td style=\"text-align: center;\">{{ doc.total_volumes }} vol</td>\n                <td style=\"text-align: right;\">{{ doc.total_peso_bruto | round(3) }} kg</td>\n            </tr>\n        </tfoot>\n    </table>\n</div>"
}