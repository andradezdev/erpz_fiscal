{
    "align_labels_right": 0,
    "creation": "2026-09-16 12:00:00.000000",
    "custom_format": 1,
    "default_print_language": "pt-BR",
    "disabled": 0,
    "doc_type": "Montagem de Carga",
    "doctype": "Print Format",
    "font_size": 11,
    "line_breaks": 0,
    "margin_bottom": 10.0,
    "margin_left": 10.0,
    "margin_right": 10.0,
    "margin_top": 10.0,
    "modified": "2026-09-16 12:00:00.000000",
    "modified_by": "Administrator",
    "module": "ERPZ Fiscal",
    "name": "Romaneio de Carga - Analítico (Com Produtos)",
    "owner": "Administrator",
    "print_format_type": "Jinja",
    "standard": "Yes",
    "html": "<div class=\"print-format romaneio-analitico\">\n    <style>\n        .romaneio-analitico { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; font-size: 11px; color: #1f2937; line-height: 1.4; }\n        .header-box { border-bottom: 2px solid #1f2937; padding-bottom: 8px; margin-bottom: 12px; }\n        .company-title { font-size: 16px; font-weight: bold; text-transform: uppercase; }\n        .doc-title { font-size: 14px; font-weight: bold; color: #4b5563; }\n        .order-card { border: 1px solid #d1d5db; margin-top: 14px; border-radius: 4px; overflow: hidden; page-break-inside: avoid; }\n        .order-header { background: #f3f4f6; padding: 8px 10px; border-bottom: 1px solid #d1d5db; display: flex; justify-content: space-between; align-items: center; }\n        .order-title { font-size: 12px; font-weight: bold; color: #111827; }\n        .order-table { width: 100%; border-collapse: collapse; }\n        .order-table th { background: #f9fafb; border-bottom: 1px solid #e5e7eb; padding: 5px 8px; font-size: 10px; text-transform: uppercase; text-align: left; }\n        .order-table td { border-bottom: 1px solid #f3f4f6; padding: 5px 8px; font-size: 10px; }\n        .order-footer { padding: 8px 10px; background: #fff; display: flex; justify-content: space-between; align-items: center; }\n        .badge { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 9px; font-weight: bold; }\n        .badge-green { background: #dcfce7; color: #15803d; }\n    </style>\n\n    <div class=\"header-box\">\n        <div style=\"display: flex; justify-content: space-between; align-items: flex-end;\">\n            <div>\n                <div class=\"company-title\">{{ doc.empresa }}</div>\n                <div class=\"doc-title\">ROMANEIO DE ENTREGA ANAL?TICO (COM PRODUTOS)</div>\n            </div>\n            <div style=\"text-align: right;\">\n                <div style=\"font-size: 15px; font-weight: bold; color: #1e40af;\">CARGA Nº {{ doc.name }}</div>\n                <div><b>Data:</b> {{ frappe.utils.format_date(doc.data_carga) }}</div>\n            </div>\n        </div>\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px; padding: 6px 10px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 4px;\">\n        <div><b>Veículo:</b> {{ doc.placa_veículo or 'N/A' }} | <b>Motorista:</b> {{ doc.motorista_nome or 'N/A' }}</div>\n        <div><b>Totais:</b> {{ doc.total_pedidos }} Pedidos | {{ doc.total_volumes }} Volumes | P. Bruto: {{ doc.total_peso_bruto | round(3) }} kg</div>\n    </div>\n\n    {% for row in doc.itens %}\n        {% set so = frappe.get_doc(\"Sales Order\", row.sales_order) %}\n        <div class=\"order-card\">\n            <div class=\"order-header\">\n                <div class=\"order-title\">\n                    [PARADA #{{ loop.index }}] Pedido: {{ row.sales_order }} &bull; Cliente: {{ row.customer_name }}\n                </div>\n                <div>\n                    {% if row.número_nfe %}\n                        <span class=\"badge badge-green\">NF-e Nº {{ row.número_nfe }}</span>\n                    {% endif %}\n                </div>\n            </div>\n\n            <div style=\"padding: 6px 10px; font-size: 10px;\">\n                <b>Volumes:</b> {{ row.volumes }} cx/vol &bull; <b>Peso Líquido:</b> {{ row.peso_liquido | round(3) }} kg &bull; <b>Peso Bruto:</b> {{ row.peso_bruto | round(3) }} kg\n            </div>\n\n            <table class=\"order-table\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 15%;\">Código</th>\n                        <th style=\"width: 45%;\">Descrição do Produto</th>\n                        <th style=\"width: 10%; text-align: center;\">UN</th>\n                        <th style=\"width: 15%; text-align: center;\">Quantidade</th>\n                        <th style=\"width: 15%; text-align: right;\">Peso Total (kg)</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for item in so.items %}\n                    {% set item_pb = frappe.db.get_value(\"Item\", item.item_code, \"peso_bruto\") or 0 %}\n                    <tr>\n                        <td><b>{{ item.item_code }}</b></td>\n                        <td>{{ item.item_name }}</td>\n                        <td style=\"text-align: center;\">{{ item.uom }}</td>\n                        <td style=\"text-align: center;\"><b>{{ item.qty }}</b></td>\n                        <td style=\"text-align: right;\">{{ (item.qty * item_pb) | round(3) }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n\n            <div class=\"order-footer\">\n                <div style=\"font-size: 9px; color: #6b7280;\">Recebido em: ____/____/________</div>\n                <div style=\"font-size: 9px; color: #6b7280;\">Assinatura Recebedor: ____________________________________</div>\n            </div>\n        </div>\n    {% endfor %}\n</div>"
}