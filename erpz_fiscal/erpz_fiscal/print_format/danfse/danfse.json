{
    "align_labels_right": 0,
    "creation": "2026-09-16 12:00:00.000000",
    "custom_format": 1,
    "default_print_language": "pt-BR",
    "disabled": 0,
    "doc_type": "Nota Fiscal de Servico Eletronica",
    "doctype": "Print Format",
    "font_size": 10,
    "html": "<div class=\"print-format danfse-a4\">\n    <style>\n        .danfse-a4 { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; font-size: 10px; color: #1f2937; line-height: 1.35; padding: 10px; }\n        .box { border: 1px solid #9ca3af; margin-bottom: 8px; border-radius: 3px; overflow: hidden; page-break-inside: avoid; }\n        .box-title { background: #f3f4f6; font-size: 9px; font-weight: bold; text-transform: uppercase; padding: 4px 8px; border-bottom: 1px solid #9ca3af; color: #111827; }\n        .box-content { padding: 6px 8px; }\n        .grid-table { width: 100%; border-collapse: collapse; }\n        .grid-table th { background: #f9fafb; border: 1px solid #d1d5db; padding: 4px 6px; font-size: 8.5px; text-transform: uppercase; text-align: center; }\n        .grid-table td { border: 1px solid #e5e7eb; padding: 5px 6px; font-size: 9px; text-align: center; }\n        .header-table td { vertical-align: middle; }\n    </style>\n\n    <!-- 1. Cabeçalho Oficial da Prefeitura -->\n    <div class=\"box\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"width: 15%; text-align: center; padding: 8px; border-right: 1px solid #9ca3af;\">\n                    <div style=\"font-size: 28px;\">🏛️</div>\n                </td>\n                <td style=\"width: 55%; padding: 8px; text-align: center; border-right: 1px solid #9ca3af;\">\n                    <div style=\"font-size: 11px; font-weight: bold; text-transform: uppercase;\">PREFEITURA MUNICIPAL DE SÃO PAULO</div>\n                    <div style=\"font-size: 9px; color: #4b5563;\">SECRETARIA MUNICIPAL DA FAZENDA</div>\n                    <div style=\"font-size: 13px; font-weight: bold; color: #1e3a8a; margin-top: 4px;\">NOTA FISCAL ELETRÔNICA DE SERVIÇOS - NFS-e</div>\n                    <div style=\"font-size: 8px; color: #6b7280;\">Documento Auxiliar da Nota Fiscal de Serviços (DANFSE - Padrão Nacional / ABRASF)</div>\n                </td>\n                <td style=\"width: 30%; padding: 8px; font-size: 9px;\">\n                    <div><b>Número da NFS-e:</b> <span style=\"font-size: 13px; color: #1e40af; font-weight: bold;\">{{ doc.numero_nfse or '2026001' }}</span></div>\n                    <div><b>Data de Emissão:</b> {{ frappe.utils.format_datetime(doc.data_emissao) }}</div>\n                    <div><b>Código Verificação:</b> <span style=\"font-weight: bold; color: #b91c1c;\">{{ doc.codigo_verificacao or 'K9L2-M4B1' }}</span></div>\n                    <div><b>Série:</b> {{ doc.serie_nfse or '1' }}</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- 2. Dados do Prestador de Serviços -->\n    <div class=\"box\">\n        <div class=\"box-title\">DADOS DO PRESTADOR DE SERVIÇOS</div>\n        <div class=\"box-content\">\n            <table style=\"width: 100%; font-size: 9.5px;\">\n                <tr>\n                    <td style=\"width: 65%;\"><b>Razão Social:</b> {{ doc.empresa }}</td>\n                    <td style=\"width: 35%;\"><b>CNPJ:</b> {{ doc.prestador_cnpj or '12.345.678/0001-95' }}</td>\n                </tr>\n                <tr>\n                    <td><b>Inscrição Municipal (IM):</b> {{ doc.prestador_im or '123.456-7' }}</td>\n                    <td><b>Município / UF:</b> {{ doc.cidade_prestacao or 'São Paulo' }} - {{ doc.uf_prestacao or 'SP' }}</td>\n                </tr>\n                <tr>\n                    <td colspan=\"2\"><b>Endereço:</b> Avenida Paulista, 1500 - Bela Vista - CEP 01310-100</td>\n                </tr>\n            </table>\n        </div>\n    </div>\n\n    <!-- 3. Dados do Tomador de Serviços (Cliente) -->\n    <div class=\"box\">\n        <div class=\"box-title\">DADOS DO TOMADOR DE SERVIÇOS (CLIENTE)</div>\n        <div class=\"box-content\">\n            <table style=\"width: 100%; font-size: 9.5px;\">\n                <tr>\n                    <td style=\"width: 65%;\"><b>Nome / Razão Social:</b> {{ doc.cliente_nome or doc.cliente }}</td>\n                    <td style=\"width: 35%;\"><b>CPF / CNPJ:</b> {{ doc.cliente_cpf_cnpj or '47.234.356/0001-53' }}</td>\n                </tr>\n                <tr>\n                    <td><b>Inscrição Municipal:</b> {{ doc.cliente_im or 'Isento' }}</td>\n                    <td><b>E-mail:</b> {{ doc.cliente_email or 'contato@cliente.com.br' }}</td>\n                </tr>\n            </table>\n        </div>\n    </div>\n\n    <!-- 4. Discriminação dos Serviços -->\n    <div class=\"box\" style=\"min-height: 120px;\">\n        <div class=\"box-title\">DISCRIMINAÇÃO DOS SERVIÇOS PRESTADOS</div>\n        <div class=\"box-content\" style=\"white-space: pre-wrap; font-size: 9.5px; min-height: 80px;\">\n{{ doc.discriminacao_servicos }}\n        </div>\n        <div style=\"background: #f9fafb; border-top: 1px solid #e5e7eb; padding: 4px 8px; font-size: 8.5px; color: #4b5563;\">\n            <b>Item da Lista de Serviços (LC 116/03):</b> {{ doc.codigo_servico_lc116 or '01.07' }} &bull; <b>CNAE:</b> {{ doc.codigo_cnae or '6202-3/00' }} &bull; <b>Local da Prestação:</b> {{ doc.cidade_prestacao }} - {{ doc.uf_prestacao }}\n        </div>\n    </div>\n\n    <!-- 5. Retenções Federais -->\n    <div class=\"box\">\n        <div class=\"box-title\">RETENÇÕES DE TRIBUTOS FEDERAIS</div>\n        <div class=\"box-content\" style=\"padding: 0;\">\n            <table class=\"grid-table\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 20%;\">PIS Retido</th>\n                        <th style=\"width: 20%;\">COFINS Retido</th>\n                        <th style=\"width: 20%;\">INSS Retido</th>\n                        <th style=\"width: 20%;\">IRRF Retido</th>\n                        <th style=\"width: 20%;\">CSLL Retida</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_pis) | round(2) }}</td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_cofins) | round(2) }}</td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_inss) | round(2) }}</td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_irrf) | round(2) }}</td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_csll) | round(2) }}</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </div>\n\n    <!-- 6. Detalhamento dos Valores e ISS -->\n    <div class=\"box\">\n        <div class=\"box-title\">CÁLCULO DO ISSQN E VALOR LÍQUIDO</div>\n        <div class=\"box-content\" style=\"padding: 0;\">\n            <table class=\"grid-table\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 20%;\">Valor dos Serviços</th>\n                        <th style=\"width: 16%;\">Deduções Legais</th>\n                        <th style=\"width: 16%;\">Base de Cálculo</th>\n                        <th style=\"width: 16%;\">Alíquota ISS</th>\n                        <th style=\"width: 16%;\">Valor do ISS</th>\n                        <th style=\"width: 16%;\">ISS Retido?</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td><b>R$ {{ frappe.utils.flt(doc.valor_servicos) | round(2) }}</b></td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_deducoes) | round(2) }}</td>\n                        <td>R$ {{ frappe.utils.flt(doc.base_calculo_iss) | round(2) }}</td>\n                        <td>{{ frappe.utils.flt(doc.aliquota_iss) | round(2) }}%</td>\n                        <td>R$ {{ frappe.utils.flt(doc.valor_iss) | round(2) }}</td>\n                        <td>{{ 'SIM' if doc.iss_retido else 'NÃO' }}</td>\n                    </tr>\n                </tbody>\n            </table>\n\n            <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 8px; background: #eff6ff; border-top: 1px solid #bfdbfe;\">\n                <div style=\"font-size: 9px; color: #1e3a8a;\">\n                    <b>Total de Deduções e Retenções:</b> R$ {{ frappe.utils.flt(doc.total_retencoes) | round(2) }}\n                </div>\n                <div style=\"font-size: 13px; font-weight: bold; color: #1e3a8a;\">\n                    VALOR LÍQUIDO DA NFS-e: R$ {{ frappe.utils.flt(doc.valor_liquido) | round(2) }}\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 7. Reforma Tributária (IBS e CBS) e Autenticidade -->\n    <div class=\"box\">\n        <div class=\"box-title\">REFORMA TRIBUTÁRIA (EC 132/23) E AUTENTICIDADE</div>\n        <div class=\"box-content\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                <div style=\"font-size: 8.5px; color: #374151; width: 75%;\">\n                    <div><b>Apuração Reforma Tributária:</b> Total IBS ({{ doc.aliquota_ibs }}%): R$ {{ frappe.utils.flt(doc.valor_ibs) | round(2) }} &bull; Total CBS ({{ doc.aliquota_cbs }}%): R$ {{ frappe.utils.flt(doc.valor_cbs) | round(2) }}</div>\n                    <div style=\"margin-top: 3px;\">Esta NFS-e foi emitida com respaldo na legislação tributária municipal e na Lei Complementar nº 116/2003.</div>\n                    <div style=\"margin-top: 3px;\">A autenticidade deste documento pode ser conferida no portal oficial da Prefeitura utilizando o número da nota e o código de verificação.</div>\n                </div>\n                <div style=\"text-align: right; width: 25%;\">\n                    <div style=\"font-size: 8px; color: #6b7280;\">Código de Verificação:</div>\n                    <div style=\"font-size: 11px; font-weight: bold; color: #b91c1c;\">{{ doc.codigo_verificacao or 'K9L2-M4B1' }}</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>",
    "line_breaks": 0,
    "margin_bottom": 8.0,
    "margin_left": 8.0,
    "margin_right": 8.0,
