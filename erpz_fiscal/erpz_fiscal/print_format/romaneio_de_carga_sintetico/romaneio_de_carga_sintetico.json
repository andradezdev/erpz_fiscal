    "modified": "2026-09-16 12:00:00.000000",
    "modified_by": "Administrator",
    "module": "ERPZ Fiscal",
    "name": "Romaneio de Carga - Sintético",
    "owner": "Administrator",
    "print_format_type": "Jinja",
    "standard": "Yes",
    "html": "<div class=\"print-format romaneio-sintetico\">\n    <style>\n        .romaneio-sintetico { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; font-size: 11px; color: #1f2937; line-height: 1.4; }\n        .header-box { border-bottom: 2px solid #1f2937; padding-bottom: 8px; margin-bottom: 12px; }\n        .company-title { font-size: 16px; font-weight: bold; text-transform: uppercase; }\n        .doc-title { font-size: 14px; font-weight: bold; color: #4b5563; }\n        .summary-grid { display: flex; gap: 10px; margin-bottom: 12px; }\n        .summary-card { flex: 1; border: 1px solid #e5e7eb; background: #f9fafb; padding: 6px 10px; border-radius: 4px; }\n        .summary-card .label { font-size: 9px; text-transform: uppercase; color: #6b7280; font-weight: bold; }\n        .summary-card .value { font-size: 13px; font-weight: bold; color: #111827; }\n        .table-data { width: 100%; border-collapse: collapse; margin-top: 10px; }\n        .table-data th { background: #f3f4f6; border: 1px solid #d1d5db; padding: 6px 8px; font-size: 10px; text-transform: uppercase; text-align: left; }\n        .table-data td { border: 1px solid #e5e7eb; padding: 6px 8px; font-size: 10px; }\n        .badge { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 9px; font-weight: bold; }\n        .badge-green { background: #dcfce7; color: #15803d; }\n        .badge-orange { background: #ffedd5; color: #c2410c; }\n        .signature-line { border-bottom: 1px dotted #9ca3af; width: 100%; height: 16px; }\n    </style>\n\n    <div class=\"header-box\">\n        <div style=\"display: flex; justify-content: space-between; align-items: flex-end;\">\n            <div>\n                <div class=\"company-title\">{{ doc.empresa }}</div>\n                <div class=\"doc-title\">ROMANEIO DE CARGA E EXPEDI??O (SINT?TICO)</div>\n            </div>\n            <div style=\"text-align: right;\">\n                <div style=\"font-size: 15px; font-weight: bold; color: #1e40af;\">Nº {{ doc.name }}</div>\n                <div><b>Data:</b> {{ frappe.utils.format_date(doc.data_carga) }}</div>\n            </div>\n        </div>\n    </div>\n\n    <table style=\"width: 100%; margin-bottom: 10px; font-size: 11px;\">\n        <tr>\n            <td style=\"width: 33%;\"><b>Transportadora:</b> {{ doc.transportadora or 'Pr?pria' }}</td>\n            <td style=\"width: 33%;\"><b>Veículo / Placa:</b> {{ doc.placa_veículo or 'N/A' }} {% if doc.uf_veículo %}({{ doc.uf_veículo }}){% endif %}</td>\n            <td style=\"width: 34%;\"><b>Motorista:</b> {{ doc.motorista_nome or 'N/A' }} {% if doc.motorista_cpf %}- CPF: {{ doc.motorista_cpf }}{% endif %}</td>\n        </tr>\n    </table>\n\n    <div class=\"summary-grid\">\n        <div class=\"summary-card\">\n            <div class=\"label\">Total de Pedidos</div>\n            <div class=\"value\">{{ doc.total_pedidos }}</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"label\">Total de Volumes</div>\n            <div class=\"value\">{{ doc.total_volumes }} cx/vol</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"label\">Total Peso Líquido</div>\n            <div class=\"value\">{{ doc.total_peso_liquido | round(3) }} kg</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"label\">Total Peso Bruto</div>\n            <div class=\"value\">{{ doc.total_peso_bruto | round(3) }} kg</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"label\">Valor Total da Carga</div>\n            <div class=\"value\">{{ frappe.utils.fmt_money(doc.valor_total_carga, currency=\"BRL\") }}</div>\n        </div>\n    </div>\n\n    <table class=\"table-data\">\n        <thead>\n            <tr>\n                <th style=\"width: 4%;\">#</th>\n                <th style=\"width: 14%;\">Nº Pedido</th>\n                <th style=\"width: 30%;\">Cliente</th>\n                <th style=\"width: 8%; text-align: center;\">Volumes</th>\n                <th style=\"width: 10%; text-align: right;\">Peso Bruto (kg)</th>\n                <th style=\"width: 14%; text-align: center;\">Nº NF Autorizada</th>\n                <th style=\"width: 20%;\">Assinatura do Recebedor</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.itens %}\n            <tr>\n                <td style=\"text-align: center;\">{{ loop.index }}</td>\n                <td><b>{{ item.sales_order }}</b></td>\n                <td>{{ item.customer_name }}</td>\n                <td style=\"text-align: center;\">{{ item.volumes }}</td>\n                <td style=\"text-align: right;\">{{ item.peso_bruto | round(3) }}</td>\n                <td style=\"text-align: center;\">\n                    {% if item.número_nfe %}\n                        <span class=\"badge badge-green\">NF-e {{ item.número_nfe }}</span>\n                    {% else %}\n                        <span class=\"badge badge-orange\">{{ item.status_faturamento }}</span>\n                    {% endif %}\n                </td>\n                <td><div class=\"signature-line\"></div></td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr style=\"background: #f9fafb; font-weight: bold;\">\n                <td colspan=\"3\" style=\"text-align: right;\">TOTAIS DA CARGA:</td>\n                <td style=\"text-align: center;\">{{ doc.total_volumes }}</td>\n                <td style=\"text-align: right;\">{{ doc.total_peso_bruto | round(3) }} kg</td>\n                <td colspan=\"2\"></td>\n            </tr>\n        </tfoot>\n    </table>\n</div>"
}